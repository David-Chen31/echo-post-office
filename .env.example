# ---- Database ----
DATABASE_URL="postgresql://letter:letter_dev_pw@localhost:5432/letter_community?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- API ----
API_PORT=4000
NODE_ENV=development

# ---- Auth (JWT) ----
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="900"          # seconds (15m)
JWT_REFRESH_TTL="2592000"     # seconds (30d)

# ---- Claim ----
CLAIM_EXPIRE_HOURS=24

# ---- Letter ----
LETTER_MIN_LENGTH=50

# ---- Mail/SMS (dev: console driver) ----
MAIL_DRIVER=console
