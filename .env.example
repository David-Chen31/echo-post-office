# ---- Database ----
DATABASE_URL="postgresql://letter:letter_dev_pw@localhost:5432/letter_community?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- API ----
API_PORT=4000
NODE_ENV=development

# ---- Auth (JWT) ----
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="900"          # seconds (15m)
JWT_REFRESH_TTL="2592000"     # seconds (30d)

# ---- Claim ----
CLAIM_EXPIRE_HOURS=24

# ---- Letter ----
LETTER_MIN_LENGTH=50

# ---- Mail (dev: console 打印验证码到日志；prod: smtp 真实发信) ----
MAIL_DRIVER=console
# 切到真实发信：MAIL_DRIVER=smtp，并填下面 SMTP（任意支持 SMTP 的邮箱/服务，如 QQ 邮箱/Gmail 应用专用密码/Resend/阿里云等）
MAIL_FROM="回声邮局 <no-reply@yourdomain.com>"
SMTP_HOST=
SMTP_PORT=587            # 587=STARTTLS，465=SSL
SMTP_USER=
SMTP_PASS=
