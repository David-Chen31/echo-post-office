{
  "name": "letter-community",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @letter/shared",
    "build:api": "npm run build -w @letter/api",
    "build:web": "npm run build -w @letter/web",
    "build": "npm run build:shared && npm run build:api",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "dev:api": "npm run start:dev -w @letter/api",
    "dev:web": "npm run dev -w @letter/web",
    "typecheck": "npm run typecheck -w @letter/shared && npm run typecheck -w @letter/api",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
